<launch>
  <!-- Restart the eef Astra camera stack when its images stop (e.g. the USB cable was pulled by a tangled arm cable
       and the driver keeps its stale handle): kills the nodelet manager, which respawns with its bonded loaders
       (respawn of astra.launch.xml). Expects to be in the robot namespace (included by gripper_astra.launch.xml). -->
  <node pkg="mobipick_bringup" type="camera_driver_relauncher.py" name="eef_main_cam_driver_relauncher"
        output="screen">
    <param name="manager" value="eef_main_cam/eef_main_cam_nodelet_manager" />
    <rosparam>
      topics: [eef_main_cam/rgb/image_raw]
      silent_s: 10.0
      grace_s: 30.0
    </rosparam>
  </node>
</launch>
