<?xml version="1.0"?>
<package format="2">
  <name>mobipick_servo</name>
  <version>0.1.0</version>
  <description>
    MoveIt Servo (Cartesian and joint jogging of the arm) for Mobipick: the servo_server configuration for the UR5 and a
    relay that passes servo's joint targets on to the arm controller only when the arm cable model allows them.
  </description>
  <maintainer email="oscar.lima@dfki.de">Oscar Lima</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>moveit_servo</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning</depend>
  <depend>octomap_msgs</depend>
  <depend>roscpp</depend>
  <depend>tf2_ros</depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- the cable model (mobipick_sim_cable_entanglement) lives in an overlay workspace (amenable_ws) and is imported at
       runtime, like grasplan's MTC cable guard; without it the relay forwards nothing -->

  <test_depend>python3-pytest</test_depend>
</package>
