  <!-- see sensor_mount.urdf.xacro for sensor_mount_link-->
  <joint name="mobipick/eef_main_cam_joint" type="fixed">
    <origin rpy="1.5707963267948966 1.5707963267948966 -1.5707963267948966" xyz="-0.032 0.033 -0.065"/>
    <parent link="mobipick/sensor_mount_link"/>
    <child link="mobipick/eef_main_cam_link"/>
  </joint>
  <link name="mobipick/eef_main_cam_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mobipick_description/meshes/sensors/astra_mini.stl"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.01625 -0.0485 0.0"/>
      <geometry>
        <box size="0.0525 0.14 0.0575"/>
        <!-- padded 0.01 for moveit collision checking-->
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="-0.01625 -0.0485 0.0"/>
      <inertia ixx="0.0003951560919375" ixy="0.0" ixz="0.0" iyy="6.1562475375e-05" iyz="0.0" izz="0.00038640609543749997"/>
    </inertial>
  </link>
  <gazebo reference="mobipick/eef_main_cam_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <joint name="mobipick/eef_main_cam_rgb_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.045 0"/>
    <parent link="mobipick/eef_main_cam_link"/>
    <child link="mobipick/eef_main_cam_rgb_frame"/>
  </joint>
  <link name="mobipick/eef_main_cam_rgb_frame"/>
  <joint name="mobipick/eef_main_cam_rgb_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="mobipick/eef_main_cam_rgb_frame"/>
    <child link="mobipick/eef_main_cam_rgb_optical_frame"/>
  </joint>
  <link name="mobipick/eef_main_cam_rgb_optical_frame"/>
  <joint name="mobipick/eef_main_cam_rgb_logical_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="mobipick/eef_main_cam_rgb_frame"/>
    <child link="mobipick/eef_main_cam_rgb_logical_frame"/>
  </joint>
  <link name="mobipick/eef_main_cam_rgb_logical_frame"/>
  <gazebo reference="mobipick/eef_main_cam_rgb_logical_frame">
    <sensor name="logical_camera" type="logical_camera">
      <logical_camera>
        <near>0.05</near>
        <far>3.50</far>
        <horizontal_fov>1.0471975511965976</horizontal_fov>
        <aspect_ratio>1.3333333333333333</aspect_ratio>
      </logical_camera>
      <visualize>false</visualize>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <plugin filename="liblogical_camera_plugin.so" name="logical_camera_plugin">
        <cameraName>mobipick/eef_main_cam</cameraName>
        <imageTopicName>rgb/logical_image</imageTopicName>
        <frameName>mobipick/eef_main_cam_rgb_logical_frame</frameName>
      </plugin>
    </sensor>
  </gazebo>
  <joint name="mobipick/eef_main_cam_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.02 0"/>
    <parent link="mobipick/eef_main_cam_link"/>
    <child link="mobipick/eef_main_cam_depth_frame"/>
  </joint>
  <link name="mobipick/eef_main_cam_depth_frame"/>
  <joint name="mobipick/eef_main_cam_depth_optical_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.025 0 0"/>
    <!-- calibration not necessary, depth_ir_offset used instead -->
    <parent link="mobipick/eef_main_cam_rgb_optical_frame"/>
    <child link="mobipick/eef_main_cam_depth_optical_frame"/>
  </joint>
  <link name="mobipick/eef_main_cam_depth_optical_frame"/>
  <gazebo reference="mobipick/eef_main_cam_depth_frame">
    <sensor name="eef_main_cam" type="depth">
      <always_on>true</always_on>
      <!-- Trial: 3 Hz instead of 1 Hz so the planning-scene octomap clears stale
             voxels in about three seconds instead of nine. Gazebo only reaches this
             if it has the rendering budget; drop back to 1.0 if the sim slows down. -->
      <update_rate>3.0</update_rate>
      <camera>
        <horizontal_fov>1.0471975511965976</horizontal_fov>
        <image>
          <format>B8G8R8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>3.50</far>
          <!-- measured on real camera: 4.0 m on orthogonal surface, 3.5 m at 60 degrees angle -->
        </clip>
      </camera>
      <plugin filename="libgazebo_ros_openni_kinect.so" name="kinect_eef_main_cam_controller">
        <cameraName>eef_main_cam</cameraName>
        <alwaysOn>true</alwaysOn>
        <updateRate>3.0</updateRate>
        <imageTopicName>rgb/image_raw</imageTopicName>
        <depthImageTopicName>depth_registered/image_raw</depthImageTopicName>
        <pointCloudTopicName>depth_registered/points</pointCloudTopicName>
        <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
        <depthImageCameraInfoTopicName>depth_registered/camera_info</depthImageCameraInfoTopicName>
        <frameName>mobipick/eef_main_cam_depth_optical_frame</frameName>
        <distortion_k1>0.0</distortion_k1>
        <distortion_k2>0.0</distortion_k2>
        <distortion_k3>0.0</distortion_k3>
        <distortion_t1>0.0</distortion_t1>
        <distortion_t2>0.0</distortion_t2>
        <pointCloudCutoff>0.35</pointCloudCutoff>
        <!-- measured on real camera (same as data sheet) -->
        <pointCloudCutoffMax>3.50</pointCloudCutoffMax>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_ros_control.so" name="gazebo_ros_control">
      <legacyModeNS>false</legacyModeNS>
    </plugin>
  </gazebo>
  <!-- MiR100 mobile base -->
  <!-- UR5 arm -->
  <!-- TODO -->
  <!-- force torque sensor-->
  <!-- TODO -->
  <gazebo>
    <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mobipick/gripper_right_outer_knucklemimic_joint_plugin">
      <joint>mobipick/gripper_finger_joint</joint>
      <mimicJoint>mobipick/gripper_right_outer_knuckle_joint</mimicJoint>
      <!-- if set to true, PID parameters from "/gazebo_ros_control/pid_gains/${mimic_joint}" are loaded -->
      <hasPID/>
      <multiplier>-1.0</multiplier>
      <offset>0</offset>
      <sensitiveness>0.0</sensitiveness>
      <!-- if absolute difference between setpoint and process value is below this threshold, do nothing; 0.0 = disable [rad] -->
      <maxEffort>10.0</maxEffort>
    </plugin>
  </gazebo>
</robot>

