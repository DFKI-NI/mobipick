    <inertial>
      <mass value="0.06"/>
      <origin rpy="0 0 0" xyz="-0.006815249 0.054455677 -0.011470736"/>
      <inertia ixx="0.000113990634" ixy="6.774217199999999e-08" ixz="-2.6418035999999996e-07" iyy="7.8279342e-05" iyz="2.4596742e-06" izz="3.7587901799999995e-05"/>
    </inertial>
