  <joint name="mobipick/sensor_mount_joint" type="fixed">
    <origin rpy="0.0 -1.5707963267948966 0.0" xyz="0.0 0.0 -0.005"/>
    <parent link="mobipick/robotiq_ft_frame_id"/>
    <child link="mobipick/sensor_mount_link"/>
