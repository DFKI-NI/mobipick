<?xml version="1.0"?>
<launch>
  <!-- three identical moelk tables scenes side by side along x (1 m between their bounding boxes), one Mobipick in each (mobipick, mobipick2,
       mobipick3); see moelk_tables_x2_spawn_sim_objects.launch -->
  <arg name="physics_profile" default="fast" />
  <arg name="gui" default="true" />
  <arg name="scene_size_x" default="15.9" doc="x extent of one scene copy [m], see moelk_tables_x2_spawn_sim_objects.launch" />
  <arg name="copy_gap" default="1.0" doc="gap between the bounding boxes of neighbouring scene copies [m]" />
  <arg name="grasp_fix" default="false" />
  <arg name="joint_limits_parameters_file" default="$(find mobipick_description)/config/joint_limits.yaml" />
  <arg name="robot_colours" default="false" doc="Tell the robots apart by colour: robot k is painted in the k-th colour of mobipick_description/config/robot_colours.yaml (1 blue, 2 orange, 3 green, 4 purple) and a broad stripe of that colour runs high along the walls of its copy of the world (visual only, above what the table cameras and base lasers see). false: today's look" />

  <include file="$(find mobipick_gazebo)/launch/worlds/moelk_tables_x2_spawn_sim_objects.launch">
    <arg name="num_robots" value="3" />
    <arg name="physics_profile" value="$(arg physics_profile)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="scene_size_x" value="$(arg scene_size_x)" />
    <arg name="copy_gap" value="$(arg copy_gap)" />
    <arg name="grasp_fix" value="$(arg grasp_fix)" />
    <arg name="joint_limits_parameters_file" value="$(arg joint_limits_parameters_file)" />
    <arg name="robot_colours" value="$(arg robot_colours)" />
  </include>
</launch>
