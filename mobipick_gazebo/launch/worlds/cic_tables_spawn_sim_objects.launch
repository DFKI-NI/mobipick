<?xml version="1.0"?>
<launch>
  <arg name="namespace" default="mobipick"    doc="Namespace to push all topics into"/>
  <arg name="robot"     default="mobipick-os" doc="Which variant of the mobipick? Can be 'mobipick-hb' or 'mobipick-os'" />
  <arg name="tf_prefix" default="$(arg namespace)" doc="tf_prefix to be used" />
  <arg name="robot_name" default="mobipick" doc="Sets the name of the robot in gazebo" />

  <arg name="physics_profile" default="fast" doc="options: slow, fast" />
  <arg name="gui" default="true" />
  <arg name="start_paused" default="true" />
  <arg name="arm_controller" default="trajectory" doc="Which arm controller to start. Options are trajectory, velocity, position" />
  <arg name="grasp_fix" default="false" doc="Attach grasped objects with the gazebo_grasp_fix plugin instead of relying on friction (legacy hack, off by default)" />
  <arg name="parking_brake" default="true" doc="Hold the parked base with the gazebo_parking_brake plugin while it gets no drive command and stands still, as the real base brakes when idle (without it the base creeps a few mm with every arm motion); false only to debug" />
  <arg name="joint_limits_parameters_file" default="$(find mobipick_description)/config/joint_limits.yaml" doc="ur5 joint limits yaml (joint_limits_no_cable_guide.yaml drops the cable guide limits of wrist_1/wrist_3, sim only)" />
  <arg name="robot_colours" default="false" doc="Tell the robots apart by colour: robot k is painted in the k-th colour of mobipick_description/config/robot_colours.yaml (1 blue, 2 orange, 3 green, 4 purple) and a broad stripe of that colour runs high along the walls of its copy of the world (visual only, above what the table cameras and base lasers see). false: today's look" />
  <arg name="open_set_objects" default="true" doc="also spawn the open-set demo objects (apple, banana, tennis ball, ...) from the mobipick_open_set_objects package (a separate repository)" />

  <!-- start Gazebo with specified world and spawn Mobipick -->
  <include file="$(find mobipick_gazebo)/launch/mobipick/mobipick_empty_world.launch">
    <arg name="joint_limits_parameters_file" value="$(arg joint_limits_parameters_file)" />
    <arg name="robot"           value="$(arg robot)" />
    <arg name="namespace"       value="$(arg namespace)" />
    <arg name="tf_prefix"       value="$(arg tf_prefix)" />
    <arg name="robot_name"      value="$(arg robot_name)" />
    <arg name="start_paused"    value="$(arg start_paused)" />
    <arg name="gui"             value="$(arg gui)" />
    <arg name="arm_controller"  value="$(arg arm_controller)" />
    <arg name="grasp_fix"       value="$(arg grasp_fix)" />
    <arg name="parking_brake"   value="$(arg parking_brake)" />
    <arg name="robot_colour_index" value="$(eval 1 if arg('robot_colours') else 0)" />
    <arg name="world_name"      value="$(find pbr_gazebo)/worlds/pbr_cic.sdf"/>
    <arg name="robot_x"         value="20.50" />
    <arg name="robot_y"         value="15.20" />
    <arg name="robot_yaw"       value="0.0" />
    <arg name="physics_profile" value="$(arg physics_profile)" />
  </include>

  <!-- robot_colours: the robot's colour as a stripe high along the walls -->
  <node if="$(arg robot_colours)" ns="$(arg namespace)" name="spawn_wall_stripe" pkg="mobipick_gazebo" type="spawn_wall_stripe.py" output="screen">
    <param name="mesh" value="package://pbr_gazebo/Media/models/pbr_cic.stl" />
    <param name="colour" value="1" />
    <param name="model_name" value="$(arg namespace)__wall_stripe" />
  </node>

  <!-- tables, objects and worker -->
  <include file="$(find mobipick_gazebo)/launch/worlds/cic_tables_scene.launch">
    <arg name="open_set_objects" value="$(arg open_set_objects)" />
  </include>
</launch>
