<?xml version="1.0" ?>
<launch>
  <arg name="gui" default="true" />
  <arg name="gui_delay" default="5" doc="Seconds to wait before starting gzclient. gzclient segfaults intermittently when it connects while gzserver is still spawning models; a short delay lets the spawn burst finish first. 0 disables the delay." />
  <arg name="world_name" default="worlds/empty.world"/> <!-- Note: the world_name is with respect to GAZEBO_RESOURCE_PATH environmental variable, but can also be an absolute path -->
  <arg name="arm_controller" default="trajectory" doc="Which arm controller to start. Options are trajectory, velocity, position" />
  <arg name="grasp_fix" default="false" doc="Attach grasped objects with the gazebo_grasp_fix plugin instead of relying on friction (legacy hack, off by default)" />

  <arg name="robot_x"   default="0.0" />
  <arg name="robot_y"   default="0.0" />
  <arg name="robot_yaw" default="0.0" />

  <arg name="namespace" default="mobipick" doc="Namespace to push all topics into"/>
  <arg name="tf_prefix" default="mobipick" doc="tf_prefix to be used" />
  <arg name="robot_name" default="mobipick" doc="Sets the name of the robot in gazebo" />
  <arg name="robot"      default="mobipick-os" doc="Which variant of the mobipick? Can be 'mobipick-hb' or 'mobipick-os'" />
  <arg name="main_camera" default="astra"
    doc="Can be 'astra' for Orbbec Astra Mini S, 'intel_d455' for Intel RealSense D455 or 'intel_d435' for Intel RealSense D435, changes the main 3D camera." />

  <arg name="start_paused" default="true" />
  <arg name="physics_profile" default="fast" doc="options: slow, fast" />

  <group>
    <remap from="$(arg namespace)/mobile_base_controller/cmd_vel" to="$(arg namespace)/cmd_vel" />
    <remap from="$(arg namespace)/mobile_base_controller/odom"    to="$(arg namespace)/odom" />
    <remap from="$(arg namespace)/joint_states"                   to="$(arg namespace)/gazebo_joint_states" />

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(arg world_name)"/>
      <arg name="paused" value="$(arg start_paused)" />
      <arg name="gui" value="false" />
      <arg name="extra_gazebo_args" value="--profile $(arg physics_profile)" />
    </include>

    <!-- Start gzclient ourselves (same node name/args as gazebo_ros/empty_world.launch) so it can be
         delayed until the initial model spawns are done; starting it together with gzserver races the
         scene loading in gzclient and intermittently crashes it with a segfault. -->
    <node if="$(arg gui)" name="gazebo_gui" pkg="gazebo_ros" type="gzclient" respawn="false" output="screen"
          launch-prefix="bash -c 'sleep $(arg gui_delay); exec &quot;$0&quot; &quot;$@&quot;'" />
  </group>

  <!-- Add passive + mimic joints to joint_states topic -->
  <group ns="$(arg namespace)">
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
      <rosparam param="source_list">[gazebo_joint_states]</rosparam>
      <param name="rate" value="60.0" />
    </node>
  </group>

  <group ns="$(arg namespace)">
    <!-- spawn robot and bring up controllers etc. -->
    <include file="$(find mobipick_gazebo)/launch/mobipick/mobipick_gazebo_common.launch">
      <arg name="robot" value="$(arg robot)" />
      <arg name="main_camera" value="$(arg main_camera)" />
      <arg name="arm_controller" value="$(arg arm_controller)" />
      <arg name="grasp_fix"      value="$(arg grasp_fix)" />
      <arg name="robot_x"   value="$(arg robot_x)" />
      <arg name="robot_y"   value="$(arg robot_y)" />
      <arg name="robot_yaw" value="$(arg robot_yaw)" />
      <arg name="tf_prefix" value="$(arg tf_prefix)" />
      <arg name="robot_name" value="$(arg robot_name)" />
    </include>
  </group>

  <!-- The gripper_hw GripperCommand action is provided directly by the gripper_controller
       (mobipick_gripper_effort_controller) spawned in mobipick_gazebo_common.launch. -->
</launch>
