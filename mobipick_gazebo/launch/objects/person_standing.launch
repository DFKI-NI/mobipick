<?xml version="1.0"?>
<launch>
  <arg name="model_name" default="person_standing_1" />
  <arg name="x" default="0.0" />
  <arg name="y" default="0.0" />
  <arg name="z" default="0.0" />
  <arg name="roll" default="0.0" />
  <arg name="pitch" default="0.0" />
  <arg name="yaw" default="0.0" />

  <param name="person_standing_description"
    command="$(find xacro)/xacro '$(find mobipick_gazebo)/urdf/person_standing.urdf.xacro'" />

  <node name="spawn_$(arg model_name)" pkg="gazebo_ros" type="spawn_model" args="-urdf
    -param person_standing_description -model $(arg model_name)
    -x $(arg x) -y $(arg y) -z $(arg z)
    -R $(arg roll) -P $(arg pitch) -Y $(arg yaw)"
    respawn="false" output="screen" />
</launch>
