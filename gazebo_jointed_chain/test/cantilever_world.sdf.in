<?xml version="1.0"?>
<!-- gazebo_jointed_chain bending stiffness test: 0.30 m of chain clamped horizontally at one end, the other end free;
     EI = @EI@ N m^2 (0 = free hinges, a rope). Physics as the Mobipick sim. -->
<sdf version="1.6">
<world name="cantilever">
  <physics type="ode"><max_step_size>0.003</max_step_size><real_time_factor>1</real_time_factor>
    <real_time_update_rate>0</real_time_update_rate>
    <ode><solver><type>quick</type><iters>200</iters><sor>1.3</sor></solver>
      <constraints><cfm>0</cfm><erp>0.2</erp><contact_max_correcting_vel>100</contact_max_correcting_vel>
        <contact_surface_layer>0.001</contact_surface_layer></constraints></ode></physics>
  <gravity>0 0 -9.81</gravity>
  <model name="holder">
    <link name="clamp"><pose>0 0 1 0 0 0</pose><inertial><mass>5</mass></inertial>
      <collision name="clamp_col"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
      <collision name="drum_col"><pose>0.15 0 -0.15 1.5708 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.2</length></cylinder></geometry></collision></link>
    <joint name="fix" type="fixed"><parent>world</parent><child>clamp</child></joint>
    <plugin name="chain" filename="libgazebo_jointed_chain.so">
      <chain_name>free_chain</chain_name>
      <parent_link>clamp</parent_link><parent_offset>0.02 0 0 0 0 0</parent_offset>
      <links>9</links><length>0.30</length><radius>0.0175</radius>
      <mass_per_link>0.0105</mass_per_link><inertia_scale>@INERTIA@</inertia_scale>
      <bend_radius>0.10</bend_radius><damping>@DAMP@</damping><bending_stiffness>@EI@</bending_stiffness>
      <collide_with>@COLLIDE@</collide_with>
      <reference_link>clamp</reference_link>
    </plugin>
  </model>
</world>
</sdf>
