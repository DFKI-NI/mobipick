<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find mobipick_description)/urdf/common_properties.urdf.xacro" />

  <!-- ODE contact parameters of the fingertip pads. Objects are held by friction alone (the gazebo_grasp_fix plugin is off by default, see grasp_fix arg),
       which needs two things: a persistent contact and a real squeeze force.
       * min_depth lets the pad sink 2 mm into the object before ODE pushes back. With the default 0 (and
         contact_surface_layer 0 in our worlds) the contacts flicker while the object is carried and it slowly
         creeps out of the gripper. Objects need the same setting on their side (see mobipick_gazebo/urdf).
       * The squeeze force is set by the torque limit and position gain of mobipick_gripper_effort_controller.
       Measured with test/grasp_rig (multimeter, 0.35 kg, carried and shaken at 1.6 m/s^2, fast physics profile):
       without min_depth or with < 1 Nm finger torque the object tilts 40 deg during the lift and falls when the
       gripper is moved, with these values it moves < 5 mm.
       The properties can be overridden by defining them before including this file. -->
  <xacro:property name="fingertip_mu" default="5.0" />
  <!-- kp is the contact stiffness, see https://classic.gazebosim.org/tutorials?tut=physics_params&cat=physics
       (5000 = soft pad, 1e6 = rigid). The pads used to be soft (5000) to gain contact area; with min_depth that
       is not needed, and 1e5 halved the slip of the multimeter and was the difference between holding and
       dropping the relay when the fingers barely touch it. -->
  <xacro:property name="fingertip_kp" default="1e5" />
  <xacro:property name="fingertip_kd" default="1.0" />
  <xacro:property name="fingertip_min_depth" default="0.002" />
  <xacro:property name="fingertip_max_vel" default="0.01" /> <!-- ODE default -->

  <xacro:macro name="robotiq_fingertip_65mm" params="prefix fingerprefix stroke">
    <link name="${prefix}${fingerprefix}_robotiq_fingertip_65mm">
      <inertial>
        <!-- <origin xyz="0 32.3E-03 -3.4587E-03" rpy="0 0 0" /> -->
        <origin xyz="0 0.0323 -0.003459" rpy="${pi} ${0.5 * pi} ${0.5 * pi}" />
        <mass value="3.3455E-2" />
        <inertia ixx="13.66E-6"
          ixy="0"
          ixz="0"
          iyy="11.784E-6"
          iyz="0"
          izz="2.15E-6" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://mobipick_description/meshes/robotiq_2f_140/robotiq_arg2f_${stroke}_fingertip_65mm.stl" />
        </geometry>
        <xacro:insert_block name="material_grey" />
      </visual>
      <collision>
        <origin xyz="0.00005 0.0325 -0.0035" rpy="0 0 0"/>
        <geometry>
          <!-- <mesh filename="package://mobipick_description/meshes/robotiq_2f_140/robotiq_arg2f_${stroke}_fingertip_65mm.stl" /> -->
          <!-- using box instead of mesh for collision produces less vibration of the fingers when grasping objects -->
          <box size="0.0271 0.065 0.007"/> <!-- values ok for stroke of 140, only? -->
        </geometry>
      </collision>
    </link>
    <gazebo reference="${prefix}${fingerprefix}_robotiq_fingertip_65mm">
      <material>Gazebo/Grey</material>
      <!-- high friction value to prevent objects from slipping the gripper fingers -->
      <mu1>${fingertip_mu}</mu1>
      <mu2>${fingertip_mu}</mu2>
      <kp>${fingertip_kp}</kp>
      <kd>${fingertip_kd}</kd>
      <minDepth>${fingertip_min_depth}</minDepth>
      <maxVel>${fingertip_max_vel}</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="fingertip_joint" params="prefix fingerprefix">
    <joint name="${prefix}${fingerprefix}_fingertip_joint" type="fixed">
      <origin xyz="0 0.013513 -0.018469" rpy="0 0 0" />
      <parent link="${prefix}${fingerprefix}_inner_finger" />
      <child link="${prefix}${fingerprefix}_robotiq_fingertip_65mm" />
      <axis xyz="0 0 1" />
    </joint>
  </xacro:macro>
</robot>
